# =============================================================================
#  Capivara Online — variáveis de ambiente do backend
#  Copie este arquivo para `.env` e preencha os valores reais.
#  (o `.env` NÃO vai para o git — veja .gitignore)
# =============================================================================

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# URL pública do FRONTEND (usada no CORS e nos links de checkout)
BASE_URL=https://capivaraonline.digital

# URL pública deste BACKEND (usada para montar a URL do webhook da MisticPay).
# Precisa ser acessível pela internet — é para cá que a MisticPay envia a
# confirmação do pagamento. Sem isso, o crédito nunca cai após o PIX.
API_PUBLIC_URL=https://api.capivaraonline.digital

# ── MisticPay (pagamento PIX) ────────────────────────────────────────────────
# ATENÇÃO: o código usa CLIENT_ID + CLIENT_SECRET (enviados nos headers `ci`/`cs`),
# NÃO uma "API_KEY". Pegue as duas credenciais no painel da MisticPay.
MISTICPAY_CLIENT_ID=seu_client_id_misticpay
MISTICPAY_CLIENT_SECRET=seu_client_secret_misticpay

# Base da API da MisticPay. O código concatena `/transactions/create`.
# Default embutido no código: https://api.misticpay.com/api
# Confirme a URL correta na documentação da sua conta MisticPay.
MISTICPAY_API_URL=https://api.misticpay.com/api

# Segredo que vai na URL do webhook (.../webhook/<SEGREDO>). Gere uma string
# aleatória longa e cadastre a URL completa do webhook no painel da MisticPay.
MISTICPAY_WEBHOOK_SECRET=string_aleatoria_longa_para_o_webhook

# ── Supabase ─────────────────────────────────────────────────────────────────
# Projeto: capivaraonline (rhjcxgtapktuffsqshyk)
SUPABASE_URL=https://rhjcxgtapktuffsqshyk.supabase.co

# service_role key (Project Settings → API). NUNCA exponha no frontend.
# Usada pelo backend para gravar compras e creditar via RPC.
SUPABASE_SERVICE_KEY=sua_service_role_key

# Segredo JWT do Supabase (Project Settings → API → JWT Settings).
# Só é necessário para projetos com tokens HS256 (segredo compartilhado).
# Projetos que já migraram para chaves assimétricas (ES256/RS256) usam o JWKS
# automaticamente e podem deixar em branco.
SUPABASE_JWT_SECRET=seu_jwt_secret_do_supabase

# ── JWT interno / tokens de servidor (rotas legadas) ─────────────────────────
JWT_SECRET=coloque_uma_chave_secreta_forte_aqui
JWT_EXPIRES_IN=2h
SERVER_KEY=chave_interna_do_servidor

# ── PostgreSQL direto (rotas legadas: /checkout, leads) ──────────────────────
# Só é usado pelas rotas antigas baseadas em `pg`. O fluxo de pagamento atual
# (/api/pagamento) usa a API REST do Supabase acima, não estas variáveis.
# Opção 1: connection string completa (tem prioridade se definida)
# DATABASE_URL=postgresql://postgres:senha@db.xxx.supabase.co:6543/postgres?sslmode=require
# Opção 2: variáveis separadas (pooler do Supabase: porta 6543)
DB_HOST=db.rhjcxgtapktuffsqshyk.supabase.co
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=sua_senha_supabase

# ── reCAPTCHA Enterprise ─────────────────────────────────────────────────────
RECAPTCHA_SECRET=sua_chave_recaptcha
RECAPTCHA_PROJECT_ID=seu_projeto_gcp

# ── SUS API (busca) ──────────────────────────────────────────────────────────
# Proxies HTTP separados por vírgula (se vazio, usa lista embutida)
# SUS_PROXIES=http://1.2.3.4:8080,http://5.6.7.8:3128
SUS_TIMEOUT_MS=10000
