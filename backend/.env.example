# Servidor
PORT=3000

# JWT
JWT_SECRET=coloque_uma_chave_secreta_forte_aqui
JWT_EXPIRES_IN=2h

# PostgreSQL / Supabase
# Opção 1: variáveis separadas (pooler do Supabase: porta 6543)
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=sua_senha_supabase

# Opção 2: connection string completa (sobrescreve as vars acima se definida)
# DATABASE_URL=postgresql://postgres:senha@db.xxx.supabase.co:6543/postgres?sslmode=require

# reCAPTCHA Enterprise
RECAPTCHA_SECRET=sua_chave_recaptcha
RECAPTCHA_PROJECT_ID=seu_projeto_gcp

# MisticPay
MISTICPAY_API_KEY=sua_chave_misticpay
MISTICPAY_API_URL=https://api.misticpay.com.br

# URL base do frontend (para montar links de checkout)
BASE_URL=https://buscaprime.com.br

# Chave interna para gerar tokens (use string aleatória longa)
SERVER_KEY=chave_interna_do_servidor

# Ambiente
NODE_ENV=production

# ── SUS API ──────────────────────────────────────────────────────────────────
# Proxies HTTP gratuitos separados por vírgula (se vazio usa lista embutida)
# SUS_PROXIES=http://1.2.3.4:8080,http://5.6.7.8:3128
SUS_TIMEOUT_MS=10000
